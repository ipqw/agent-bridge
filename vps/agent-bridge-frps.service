[Unit]
Description=frps for Agent Bridge (test)
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
EnvironmentFile=/etc/agent-bridge/frps.env
ExecStart=/usr/local/bin/frps -c /etc/agent-bridge/frps.toml
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
