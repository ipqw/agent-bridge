# systemd --user unit for the agent's user on the place: stcp visitors to the user's machine.
# ~/.config/agent-bridge/frpc-visitor.toml is the file from the bridge window ("Для места"), chmod 600.
[Unit]
Description=Agent Bridge stcp visitor
After=network-online.target

[Service]
ExecStart=%h/.local/bin/frpc -c %h/.config/agent-bridge/frpc-visitor.toml
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
